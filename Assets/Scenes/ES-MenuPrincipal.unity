  m_Script: {fileID: 11500000, guid: 8b9c0d1e2f3a4567890abcdef1234567, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textoEspanol: "Misiones de Rescate disponibles. Estas pueden solicitarse desde
    el men\xFA de descanso y brindar\xE1n ayuda a la caravana. Se generan en la Ciudad
    Puerto de Serria."
  textoIngles: 'Rescue Missions available. These can be requested from the Rest Menu
    and will provide assistance to the caravan. They are generated in the Port City
    of Serria.

'
  textoPortugues: "Miss\xF5es de Resgate dispon\xEDveis. Elas podem ser solicitadas
    no Menu de Descanso e fornecer\xE3o ajuda \xE0 caravana. S\xE3o geradas na Cidade
    Portu\xE1ria de Serria.\r\n"
  traducirTextoEspanol: 0
  manager: {fileID: 0}
--- !u!114 &1450539864
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1450539861}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8b9c0d1e2f3a4567890abcdef1234567, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textoEspanol: "Cada vez que una caravana atraviesa esta regi\xF3n durante la campa\xF1a,
    el Nivel de Alerta aumentar\xE1 en 1, aumentando las chances de emboscadas enemigas
    en la regi\xF3n. (Desactivado en la Demo)"
  textoIngles: 'Each time a caravan crosses this region during the campaign, its
    Alert Level will increase by 1, increasing the chance of enemy ambushes in the
    region. (Disabled in the Demo)

'
  textoPortugues: "Cada vez que uma caravana atravessar esta regi\xE3o durante a
    campanha, o N\xEDvel de Alerta aumentar\xE1 em 1, aumentando as chances de emboscadas
    inimigas na regi\xE3o. (Desativado na Demo)\n"
  traducirTextoEspanol: 0
  manager: {fileID: 0}
