  m_text: "Campa\xF1a:\n\nMen\xFA Descanso     -- \"R\"\nMen\xFA Personajes   --
    \"C\"\nMen\xFA Mejoras   -- \"I\"\nMen\xFA S\xE9quitos  -- \"M\"\n\n\n-----------------------------------------------\nBatallas:\n\nSiguiente
    Turno  -- \"Espacio\"\nInformaci\xF3n Unidad  -- \"I\"\nModo R\xE1pido -- \"F\"\nSeleccionar
    Habilidad  -- \"1, 2, 3, 4...\"\n"
  m_isRightToLeft: 0
