  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '                                                                   <b>DEMO
    VERSION</b>





    This demo includes the tutorial and the complete <b><color=#D6A84B>Burning
    Forest</color></b> region.



    Although the adventure is limited to this region,
    no two expeditions will be the same. New <color=#D6A84B>paths, encounters, and
    characters</color> can completely change the experience.



    The full version
    will expand the journey with <b><color=#D6A84B>new regions, enemies, and challenges</color></b>.







    <color=#A0A0A0><i>To
    help us improve the game, we collect information about your experience in real
    time during gameplay. If you wish to <b><color=#B8B8B8>disable telemetry</color></b>,
    you can do so now.</i></color>'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
