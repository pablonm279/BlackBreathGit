      m_Calls: []
  m_text: "<b>---Efectos </b>\n\nCada vez que comienza el Turno de una Unidad, recibir\xE1
    los efectos de los Estados que posea, por ejemplo, si la Unidad est\xE1 prendida
    fuego, recibir\xE1 el da\xF1o apropiado al comenzar su turno.\n\nEn cuanto a
    los Buffs/Debuffs (efectos de alteraci\xF3n de atributos, positivos/negativos),
    reducir\xE1n su duraci\xF3n <b>al final</b> del Turno de la Unidad, si la duraci\xF3n
    de un Buff llega a 0, se eliminar\xE1. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
    serializedVersion: 2
    rgba: 4278190080
  m_fontColor: {r: 0, g: 0, b: 0, a: 1}
  m_enableVertexGradient: 0
  m_colorMode: 3
  m_fontColorGradient:
    topLeft: {r: 1, g: 1, b: 1, a: 1}
