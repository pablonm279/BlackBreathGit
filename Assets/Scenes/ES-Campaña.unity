  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "O <b>Respiro Negro</b> \xE9, sem d\xFAvida, a principal amea\xE7a para
    a caravana nesta jornada.\nEspalhando-se sem freio desde o momento em que o Lich
    Kadryn foi destru\xEDdo, ele avan\xE7a de forma implac\xE1vel, matando e corrompendo
    todo ser vivo que n\xE3o tenha conseguido escapar.\n\nVoc\xEA o ver\xE1 avan\xE7ando
    pela esquerda da sua tela, como uma n\xE9voa verde amea\xE7adora.\n\n<b>---Avan\xE7o</b>\n\n\u2022Ao
    viajar, a caravana faz o Respiro avan\xE7ar em 1. (2 em caminhos dif\xEDceis)\n\n\u2022Ao
    descansar, o Respiro avan\xE7a em 2.\n\n\u2022Ao ser derrotado por Corrompidos,
    o Respiro avan\xE7ar\xE1 em 1.\n\n\u2022<b>Eventos Aleat\xF3rios</b> e Nodos
    espec\xEDficos tamb\xE9m poder\xE3o afetar o avan\xE7o do Respiro."
  m_isRightToLeft: 0
