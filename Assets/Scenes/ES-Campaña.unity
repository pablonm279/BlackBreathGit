  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "As Batalhas acontecem por Turnos.\nIsso significa que cada Unidade age
    apenas quando chega o seu momento e, enquanto uma Unidade estiver agindo, nenhuma
    outra poder\xE1 faz\xEA-lo, salvo por meio de Rea\xE7\xF5es.\n\n<b>---Rodadas</b>\n\nUma
    Rodada representa o ciclo em que todas as Unidades realizam seu Turno.\nQuando
    isso acontece, uma nova Rodada come\xE7a.\n\n<b>---Iniciativa</b>\n\nA Iniciativa
    \xE9 uma caracter\xEDstica de cada Unidade. No in\xEDcio do Combate, todos os
    participantes fazem uma rolagem de 1d20 + Iniciativa. De acordo com os resultados,
    a ordem de atua\xE7\xE3o das Unidades dentro da Rodada \xE9 organizada do maior
    para o menor. Essa ordem permanecer\xE1 durante todo o combate.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
