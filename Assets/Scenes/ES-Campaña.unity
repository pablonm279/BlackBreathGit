  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "En este men\xFA puedes ver la informaci\xF3n de cada <b>Personaje</b>:
    atributos de combate, rasgos, estados temporales y m\xE1s.\n\n<i>Actualmente</i>
    existen <b>5 Clases</b> de <b>Personajes</b>, cada una con mec\xE1nicas y estilos
    de juego distintos.\n\nLos <b>Personajes</b> se generan de forma <b>procedimental</b>:
    comienzan con habilidades iniciales <b>aleatorias</b> dentro de su <b>Clase</b>,
    y aprender\xE1n nuevas habilidades al subir ciertos <b>Niveles</b>."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
