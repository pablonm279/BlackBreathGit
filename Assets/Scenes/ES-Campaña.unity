  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\nThe <b>Black Breath</b> is without a doubt the main threat to the caravan
    on this journey.\nSpreading uncontrollably since the moment the Lich Kadryn was
    destroyed, it advances relentlessly, killing and corrupting every living being
    that failed to escape its reach.\n\nYou\u2019ll see it moving in from the left
    side of the screen, as a menacing green mist.\n\n\n<b>---Advance</b>\n\n\u2022
    When the caravan travels, the Breath advances by 1. (2 on difficult paths)\n\n\u2022
    When resting, the Breath advances by 2.\n\n\u2022 If defeated by the Corrupted,
    the Breath will advance by 1.\n\n\u2022 <b>Random Events</b> and specific Nodes
    may also affect the Breath\u2019s progression."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
