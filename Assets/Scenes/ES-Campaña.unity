  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>---Ataque vs Defesa</b>\nAo realizar um Ataque contra uma Unidade,
    \xE9 feita uma rolagem de 1d20 + Ataque do Usu\xE1rio contra a Defesa da Unidade
    atacada. Os seguintes resultados podem ocorrer:\n\n\u2022<b>Se a rolagem do dado
    resultar em 1:</b> considera-se uma Falha Cr\xEDtica; a Habilidade n\xE3o tem
    efeito, -1 PA.\n\u2022<b>Se o resultado total for menor que a Defesa:</b> considera-se
    uma Falha, e a Habilidade n\xE3o tem efeito.\n\u2022<b>Se o resultado total for
    igual \xE0 Defesa:</b> considera-se um Rasp\xE3o, e ser\xE1 causado metade do
    dano.\n\u2022<b>Se o resultado total for maior que a Defesa:</b> considera-se
    um Acerto, e os efeitos da Habilidade s\xE3o aplicados normalmente.\n\u2022<b>Se
    a rolagem do dado resultar em 20:</b> Cr\xEDtico: causa 50% de dano extra.\n\n<b>Independentemente
    do resultado, cada Ataque recebido reduz em 1 a Defesa do alvo durante o Turno.</b>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
