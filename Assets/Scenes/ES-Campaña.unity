  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 <b>Condemned:</b> Each <b>X</b> adds one Turn to the counter. When
    the counter reaches zero, the Unit suffers True Damage equal to 15% of its Maximum
    Health.\n\n\u2022 <b>Bleeding:</b> Each <b>X</b> negates 2 points of Healing
    and is removed in the process. In addition, at the start of each Turn, the Unit
    loses 1 point of Maximum Health per <b>X</b>. The effect decreases by 1 per Turn.\n\n\u2022
    <b>Poisoned:</b> Each <b>X</b> deals 1 Damage per Turn to the Unit. The Unit
    must then make a Fortitude Saving Throw against <b>7 + X</b>. If it fails, the
    Poison increases by 1; if it succeeds, it is cured.\n\nThere are several other,
    simpler Status Effects not detailed here, each of which is described appropriately
    within the combat interface."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
