  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A <b>Explora\xE7\xE3o Passiva</b> \xE9 a capacidade da Caravana de revelar
    o Tipo de um <b>N\xF3 Desconhecido</b> adjacente \xE0 sua posi\xE7\xE3o.\r\n\r\nEla
    consiste em uma Rolagem de % de chance para cada N\xF3 adjacente, realizada sempre
    que a Caravana chega a um novo N\xF3 ou descansa.\r\n\r\nSe a rolagem for bem-sucedida,
    o Tipo desse N\xF3 ser\xE1 revelado.\r\n\r\nAl\xE9m disso, uma nova Rolagem ser\xE1
    feita a partir da posi\xE7\xE3o do N\xF3 revelado, mas com -30% de chance. Portanto,
    \xE9 poss\xEDvel revelar N\xF3s al\xE9m dos adjacentes.\r\n\r\nSe a rolagem falhar,
    o N\xF3 passar\xE1 a ser um <b>N\xF3 Misterioso</b>, e seu Tipo s\xF3 ser\xE1
    revelado ao viajar at\xE9 ele ou por meio da <b>Explora\xE7\xE3o Ativa</b>.\r\n\r\nA
    <b>Explora\xE7\xE3o Passiva</b> pode ser aumentada por meio de <b>Atividades</b>
    de personagens, melhorias da Caravana, etc.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
