  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Cada regi\xE3o representa uma \xE1rea que a caravana deve atravessar para avan\xE7ar
    em sua jornada rumo ao <b>Porto de Serria</b>.\n\nEm uma campanha completa de
    <b>The Black Breath</b>, a caravana precisar\xE1 sobreviver \xE0 travessia de
    3 regi\xF5es diferentes.\n\nAo concluir uma regi\xE3o, duas op\xE7\xF5es aleat\xF3rias
    aparecer\xE3o para a pr\xF3xima. Se for a terceira regi\xE3o atravessada, isso significa
    que a caravana chegou com sucesso ao <b>Porto de Serria</b>, somando o n\xFAmero
    total de Civis e Personagens \xE0 cidade que se prepara para partir.\n\n<b>----Climas</b>\n\nCada
    regi\xE3o apresenta diferentes tipos poss\xEDveis de clima, \xE0s vezes at\xE9 exclusivos,
    que mudar\xE3o sempre que a caravana descansar. Esses climas ter\xE3o diversos
    efeitos sobre a jornada."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
