  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>---Structure</b>\n\nThe Battlefield is divided into two Grids of 3
    Columns by 5 Rows.\n\nOn the left Grid are your Characters and Allies, sometimes,
    along with various Obstacles and hazardous tiles (or traps).\n\nOn the right
    Grid are the enemies you must defeat to claim victory.\n\nCharacters remain within
    their own Grid throughout the battle and cannot move into the enemy\u2019s side.\n\nMastering
    the terrain, coordinating your party, and exploiting enemy positioning are key
    to survival.\n\nFurther details are explained in the <b>Grids</b> section."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
