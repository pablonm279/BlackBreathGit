  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>---Habilidades</b>\nTanto os Personagens da Caravana quanto os Inimigos
    possuem diversas Habilidades que podem usar em seu Turno.\nCada habilidade tem
    seu custo em PA, seus Efeitos, seu Alcance e seu <b>Tempo de Recarga</b>.\n\nAs
    habilidades com <b>Tempo de Recarga</b> n\xE3o podem ser usadas at\xE9 que ele
    termine.\nEx.: se uma habilidade tiver 3 Turnos de Tempo de Recarga, ele ser\xE1
    reduzido em 1 por Rodada e a habilidade poder\xE1 ser usada novamente quando
    chegar a 0.\n\n<b>---Esfor\xE7o</b>\nAlgumas Habilidades permitem tomar \u201Cemprestado\u201D
    at\xE9 uma certa quantidade de PA do turno seguinte. Isso permitir\xE1 usar Habilidades
    mesmo quando os PA n\xE3o forem suficientes, mas esses PA emprestados ser\xE3o
    descontados no Turno seguinte da Unidade.\n\nAl\xE9m disso, uma criatura Esfor\xE7ada
    ter\xE1 sua Defesa reduzida at\xE9 o turno seguinte."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
