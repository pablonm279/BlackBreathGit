  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "La Valent\xEDa Global representa la moral colectiva de tus aliados en
    combate.\r\n\r\nSe calcula con el promedio de VAL actual del grupo y se muestra
    en porcentaje.\r\r\n\r\r\nUmbrales:\r\n- Muy Alta (>=90%): todos los aliados
    ganan +15% da\xF1o y +1 PA m\xE1ximo por 1 ronda.\r\n- Alta (>=70%): todos los
    aliados ganan +1 PA m\xE1ximo por 1 ronda.\r\n- Baja (<40%): al iniciar la ronda,
    todos tiran TS Mental.\r\n  DC = 15 - VAL actual.\r\n  Si fallan: reciben Dudando
    por 1 ronda (-10% da\xF1o, -1 Defensa).\r\n- Muy Baja (<15%): misma TS Mental.\r\n 
    Si fallan: 1 aliado por ronda huye avergonzado de la batalla.\r\n  Los dem\xE1s
    fallos de esa ronda reciben Dudando.\r\n\r\nInicio de batalla:\r\nLa Esperanza
    de la caravana ajusta la VAL inicial de cada aliado:\r\npor cada 20 puntos por
    encima/debajo de 50, gana/pierde 1 VAL.\r\n\r\nSi una unidad huye por moral,
    queda Avergonzada en campa\xF1a hasta cambiar de regi\xF3n\r\n(-2 TS Mental, -10%
    HP m\xE1xima).\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ff458e0654087aa41a97fa8ea3db3b66, type: 2}
  m_sharedMaterial: {fileID: -4687675609486072877, guid: ff458e0654087aa41a97fa8ea3db3b66, type: 2}
