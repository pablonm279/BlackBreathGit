  m_text: "Campa\xF1a:\n\nMen\xFA Descanso     -- \"R\"\nMen\xFA Personajes   --
    \"C\"\nMen\xFA Mejoras   -- \"I\"\nMen\xFA S\xE9quitos  -- \"M\"\nGuardar Partida
