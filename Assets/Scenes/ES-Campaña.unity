  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>---Efeitos</b>\n\nSempre que o Turno de uma Unidade come\xE7ar, ela
    receber\xE1 os efeitos dos Estados que possuir. Por exemplo, se a Unidade estiver
    em chamas, receber\xE1 o dano apropriado no in\xEDcio do seu turno.\n\nQuanto
    aos Buffs/Debuffs (efeitos positivos ou negativos que alteram atributos), sua
    dura\xE7\xE3o ser\xE1 reduzida <b>ao final</b> do Turno da Unidade. Se a dura\xE7\xE3o
    de um Buff chegar a 0, ele ser\xE1 removido."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
