      m_Calls: []
  m_text: "El orden de los turnos se decide por una <b>tirada de iniciativa</b> al
    comienzo del combate y podr\xE1s verlo en la barra superior.\n\nEn este caso,
    le ha tocado a tu Acechador actuar primero su turno y podr\xE1 utilizar todos
    sus <b>Puntos de Acci\xF3n (PA)</b> antes de tener que terminar su turno.\n\n                           "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
