  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022<b>Condenado:</b> Cada <b>X</b> adiciona 1 Turno ao contador. Quando
    o contador chegar a zero, a Unidade sofrer\xE1, como Dano Verdadeiro, 15% da
    sua Vida M\xE1xima.\n\n\u2022<b>Sangramento:</b> Cada <b>X</b> nega 2 de Cura
    e \xE9 removido ao faz\xEA-lo. Al\xE9m disso, a cada Turno, a Unidade perde 1
    de Vida M\xE1xima por <b>X</b>. Diminui em 1 a cada turno.\n\n\u2022<b>Veneno:</b>
    Cada <b>X</b> causa 1 de Dano por Turno \xE0 Unidade. Al\xE9m disso, realiza
    um Teste de Resist\xEAncia de Fortaleza contra <b>7+X</b>. Se falhar, o Veneno
    aumenta em 1; se passar, \xE9 curado.\n\nH\xE1 v\xE1rios outros Estados mais
    simples que n\xE3o explicaremos aqui, mas que ter\xE3o sua descri\xE7\xE3o adequada
    na interface de combate."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
