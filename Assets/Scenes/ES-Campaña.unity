  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\nDurante su turno, una Unidad posee una cierta cantidad de <b>Puntos
    de Acci\xF3n (PA)</b>.\nCada acci\xF3n que decida hacer durante el turno tendr\xE1
    su costo en PA, y cuando no tenga mas PA, no podr\xE1 realizar mas acciones y
    deber\xE1 terminar su Turno.\n\n\n\n<b>---Movimiento</b>\n\nPara mover a una
    Unidad bajo tu control a otra casilla, deber\xE1s hacer click con el bot\xF3n
    izquierdo del mouse, en una casilla <b>Adyacente</b>. Si la Unidad posee los
    PA suficientes se mover\xE1 a esa Casilla.\nEl desplazamiento a una casilla adyacente
    ortogonal (en cruz) tiene un costo de 1 PA, mientras que moverse a una casilla
    adyacente diagonal requiere 2 PA.\n\n\n\n\n "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
