  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Bien, haz tenido una buena tirada de dados y el ataque ha sido un <b>Golpe
    Cr\xEDtico</b> realizando mas da\xF1o.\n\nPara ver m\xE1s informaci\xF3n sobre
    el sistema del combate (y otras mec\xE1nicas), puedes apretar <b>\"H\"</b> y
    abrir el Manual del juego.\n\nAdem\xE1s, la flecha indica el Registro de batalla,
    puedes verlo colocando el rat\xF3n encima.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
