  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A Valentia Global representa o moral coletivo dos seus aliados em combate.\n\nEla
    \xE9 calculada com base na m\xE9dia atual de VAL do grupo e exibida como uma
    porcentagem.\n\nLimiares:\n\nMuito Alta (>=90%): todos os aliados ganham +15%
    de dano e +1 de PA M\xE1x. por 1 rodada.\nAlta (>=70%): todos os aliados ganham
    +1 de PA M\xE1x. por 1 rodada.\nBaixa (<40%): no in\xEDcio da rodada, todos os
    aliados fazem uma Salvaguarda Mental.\nCD = 15 - VAL atual.\nEm caso de falha:
    recebem Hesitante por 1 rodada (-10% de dano, -1 de Defesa).\nMuito Baixa (<15%):
    mesma Salvaguarda Mental.\nEm caso de falha: 1 aliado por rodada foge da batalha
    por vergonha.\nAs outras falhas nessa rodada recebem Hesitante.\n\nIn\xEDcio
    da batalha:\nA Esperan\xE7a da Caravana ajusta a VAL inicial de cada aliado:\na
    cada 20 pontos acima ou abaixo de 50, ele ganha ou perde 1 de VAL.\n\nSe uma
    unidade fugir por moral, ela recebe o estado de campanha Envergonhado at\xE9
    mudar de regi\xE3o\n(-2 em Salvaguarda Mental, -10% de Vida M\xE1x.)."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ff458e0654087aa41a97fa8ea3db3b66, type: 2}
  m_sharedMaterial: {fileID: -4687675609486072877, guid: ff458e0654087aa41a97fa8ea3db3b66, type: 2}
