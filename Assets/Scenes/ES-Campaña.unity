  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<i>\"Debemos dejar en alto llamas de esperanza que sirvan de gu\xEDa para
    aquellas caravanas perdidas en el camino.\"</i> \n\nCada Tier de las Almenaras
    otorgar\xE1 un bonus de 5 <b>Esperanza</b> cada vez que una caravana comience
    a viajar por una regi\xF3n nueva. \n\nAdem\xE1s, cada Tier dar\xE1 <b>1 stack</b>
    de una mejora de Caravana al azar al comenzar una regi\xF3n nueva. Si otorga
    varios por Tier, siempre ser\xE1n de la misma mejora. \n\nAdem\xE1s, cada Tier
    dar\xE1 <b>+3%</b> chances de Exploraci\xF3n para las caravanas futuras.\n\n\n\n\n "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
