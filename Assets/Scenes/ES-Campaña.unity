  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>---Nocividad del Aliento</b>\n\nMientras menor la distancia del Aliento
    a la caravana, mayor ser\xE1 su impacto mortal en la misma. Si se viaja a una
    distancia segura, esto animar\xE1 a la caravana, dando Esperanza gradualmente.
    Por otro lado, si el Aliento alcanza a la caravana, comenzar\xE1n a morir Civiles
    y Bueyes, mientras la Esperanza se desmorona, adem\xE1s, los <b>Corrompidos</b>
    ser\xE1n m\xE1s frecuentes.\n\n\n<b>---Corrompidos </b>\n\nCriaturas alteradas
    por la presencia del Aliento, han perdido su voluntad y ahora deambulan feroces,
    impulsados por su sufrimiento f\xEDsico. \nPueden aparecer en cualquier combate
    sorpresivamente pero su frecuencia y poder aumenta considerablemente cuando la
    caravana est\xE1 envuelta en el Aliento.\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
