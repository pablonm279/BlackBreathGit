  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>-----Explora\xE7\xE3o Ativa</b>\n\nA Explora\xE7\xE3o Ativa serve para
    revelar o tipo de um <b>N\xF3 Misterioso</b> adjacente \xE0 posi\xE7\xE3o da
    Caravana.\n\nEla \xE9 ativada com o <b>Bot\xE3o Direito</b> do mouse, e custar\xE1
    5 Civis.\n\nO Alento Negro avan\xE7ar\xE1 uma posi\xE7\xE3o e, a menos que a
    tentativa falhe, o Tipo do N\xF3 selecionado ser\xE1 revelado e os Civis retornar\xE3o.\n\nSe
    falhar, os Civis ser\xE3o perdidos."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
