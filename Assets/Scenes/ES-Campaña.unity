  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Each zone represents an area that the caravan must cross in order to advance
    on its journey toward the <b>Port of Serria</b>.\n\nIn a full playthrough of
    <b>The Black Breath</b>, the caravan will need to make it through 3 different
    Zones alive.\n\nUpon completing a Zone, two random options will appear for the
    next one. If it\u2019s the third Zone crossed, it means the caravan has successfully
    reached the <b>Port of Serria</b>, adding the total number of Civilians and Characters
    to the city that prepares to depart.\n\n<b>----Climates</b>\n\nEach Zone features
    different possible weather types (sometimes even exclusive ones) that will change
    every time the caravan rests. These climates will have various effects on the
    journey."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_fontSharedMaterials: []
