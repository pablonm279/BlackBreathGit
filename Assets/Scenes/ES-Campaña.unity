  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>---Oro</b>\n\nPese a la catastr\xF3fica situaci\xF3n, el Oro sigue
    siendo la forma principal de intercambio entre pares. Utilizada para contratar
    servicios o comprar bienes en el camino. \nCada moneda que no utilices en el
    viaje podr\xE1 ser utilizada en el <b>Puerto de Serria</b>.\n\n\n<b>---Suministros</b>\n\nProvisiones
    escenciales para la supervivencia de la Caravana, al descansar, los Civiles consumir\xE1n
    1, los Bueyes 2.\n\n\n<b>---Materiales</b>\n\nElementos utilizados en mejoras
    generales para la caravana y s\xE9quitos espec\xEDficos. \n\nTanto los Suministros
    como los Materiales pueden ser recolectados en Nodos de Recursos o con una <b>Tarea
    Civil</b>.\n\n\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
    serializedVersion: 2
