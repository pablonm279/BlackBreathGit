  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Turn order is determined by an <b>initiative roll</b> at the start of
    the battle, and you can see it on the top bar.\n\nIn this case, your Stalker
    acts first and can use all of their <b>Action Points (AP)</b> before ending their
    turn.\n\n\n              "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
