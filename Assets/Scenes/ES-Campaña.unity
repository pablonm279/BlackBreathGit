  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n<b>---Attack vs Defense</b>\n\nWhen an Attack is made against a Unit,
    a roll of 1d20 + the attacker\u2019s Attack value (modified by the Ability used)
    is made against the target\u2019s Defense. The following outcomes may occur:\n\n\u2022
    <b>If the die roll is 1:</b> It is considered a Fumble. The Ability has no effect,
    and the Unit\u2019s Turn ends.\n\u2022 <b>If the total roll is lower than the
    Defense:</b> It is considered a Miss, and the Ability has no effect.\n\u2022
    <b>If the total roll equals the Defense:</b> It is considered a Graze, dealing
    half damage.\n\u2022 <b>If the total roll is higher than the Defense:</b> It
    is considered a Hit, and the Ability\u2019s effects are applied normally.\n\u2022
    <b>If the die roll is 20:</b> It is considered a Critical Hit, dealing 50% additional
    damage.\n\n<b>Regardless of the Result, each Attack received by a unit will decrease
    its Defense by 1 until his next turn</b>\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
