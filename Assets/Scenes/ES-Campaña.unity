  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022<b>Condenado:</b> Cada <b>X</b> agrega un Turno al contador, cuando
    el Contador llegue a cero, la Unidad sufrir\xE1 como Da\xF1o Verdadero un 15%
    de su Vida M\xE1xima.\n\n\u2022<b>Sangrado:</b> Cada <b>X</b> niega 2 de Curaci\xF3n
    y es eliminado al hacerlo. Adem\xE1s, cada Turno, la Unidad pierde 1 de Vida
    M\xE1xima por <b>X</b>.  Disminuye en 1 cada turno.\n\n\u2022<b>Veneno:</b> Cada
    <b>X</b> hace 1 de Da\xF1o por Turno a la Unidad. Adem\xE1s, realiza una Tirada
    de Salvaci\xF3n de Fortaleza conta  <b>7+X</b>. Si no se Salva, el Veneno aumenta
    en 1, si se salva, se cura.\n\n\nHay varios otros Estados mas simples que no
    explicaremos aqu\xED, pero que tendr\xE1n su adecuada descripci\xF3n en la interfaz
    de combate."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
