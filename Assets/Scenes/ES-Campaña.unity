  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>---Tipos de Da\xF1os / Cr\xEDticos</b>\nCada tipo de Da\xF1o tiene
    un efecto especial en el objetivo si adem\xE1s el ataque es Cr\xEDtico, aclarados
    a continuaci\xF3n:\n\n\u2022<b>Cortante:</b> Produce Sangrado en el objetivo.\n\u2022<b>Perforante:</b>
    Ignora Armadura.\n\u2022<b>Contundente:</b> Reduce 1 el AP del objetivo.\n\n\u2022<b>Fuego:</b>
    Produce Ardiendo en el objetivo.\n\u2022<b>Fr\xEDo:</b> Produce Congelado en
    el objetivo.\n\u2022<b>Rayo:</b> Produce Aturdido en el objetivo.\n\u2022<b>\xC1cido:</b>
    Reduce Armadura.\n\u2022<b>Arcano:</b> Reduce Resistencias elementales.\n\u2022<b>Necro:</b>
    Leves chances de matar instant\xE1neamente.\n\u2022<b>Divino:</b> Produce Condenado
    en el objetivo.\n\n\n\nLos estados mencionados arriba y sus efectos se aclaran
    en la pesta\xF1a de Estados."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
