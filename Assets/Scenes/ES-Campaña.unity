  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "You\u2019ll notice a greenish mist creeping in from the edge of the map.\nThat
    mist is <b>The Black Breath</b>. The caravan must flee from it: if it catches
    you, it will have harmful effects.\n\nThe Breath advances:\n<b>1</b> each time
    you travel (<b>2</b> on rugged paths)\n<b>2</b> when you rest\nThat\u2019s why
    it\u2019s important to manage rests carefully and avoid falling behind."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
