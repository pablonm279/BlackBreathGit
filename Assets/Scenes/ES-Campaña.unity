      m_Calls: []
  m_text: "Up here you can see the most important resources: <b>Hope</b> and <b>Civilians</b>.\n\n<b>Hope</b>
    reflects the caravan\u2019s morale and confidence. Your decisions and the events
    along the journey will raise or lower it,  it\u2019s important to keep it high.\n\n<b>Civilians</b>
    are the people traveling with the caravan. Your goal is to keep as many of them
    alive as possible and bring them to the <b>Port City of Serria</b>."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
