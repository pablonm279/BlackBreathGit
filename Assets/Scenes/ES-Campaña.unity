  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The <b>Passive Exploration</b> is the Caravan\u2019s ability to reveal
    the Type of an adjacent <b>Unknown Node</b>.\r\n\r\nIt consists of a % Chance
    Roll for each adjacent Node, made every time the Caravan reaches a new Node or
    rests.\r\n\r\nIf the roll succeeds, the Type of that Node will be revealed.\r\n\r\nAdditionally,
    a new Roll will be made from the position of the revealed Node, but with -30%
    chance. Therefore, it is possible to reveal Nodes beyond the adjacent ones.\r\n\r\nIf
    the roll fails, the Node will become a <b>Mysterious Node</b>, and its Type will
    only be revealed by traveling to it or through <b>Active Exploration</b>.\r\n\r\n<b>Passive
    Exploration</b> can be increased through character <b>Activities</b>, Caravan
    upgrades, etc.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
