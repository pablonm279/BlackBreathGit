  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>---Ataque vs Defensa</b>\nAl realizarse un Ataque contra una Unidad
    se realiza una Tirada de Dado de 1d20 + Ataque del Usuario vs la Defensa de la
    Unidad atacada. Los siguientes resultados pueden darse:\n\n\u2022<b>Si la Tirada
    de Dado da 1:</b> Se considera Pifia, la Habilidad no tiene efectos y se pierde
    1 Val y PA Extra.\n\u2022<b>Si la Tirada Total es Menor a la Defensa:</b> Se
    considera Fallo y la Habilidad no tiene efectos.\n\u2022<b>Si la Tirada Total
    es Igual a la Defensa:</b> Se considera Roce y se har\xE1 la mitad del da\xF1o.\n\u2022<b>Si
    la Tirada Total es Mayor a la Defensa:</b> Se considera Golpe y se aplican los
    efectos de la Habilidad normalmente.\n\u2022<b>Si la Tirada de Dado es  20:</b>
    Cr\xEDtico: se har\xE1 un 50% de da\xF1o extra.\n\n<b>Independientemente del
    resultado, cada Ataque recibido baja en 1 la Defensa del objetivo por el Turno</b>\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
