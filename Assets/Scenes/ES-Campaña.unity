  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>---Valent\xEDa</b>\n\nLa Valent\xEDa es un Atributo de los Personajes
    de la Caravana. Va disminuyendo/aumentando seg\xFAn la batalla fluya en contra
    o a favor.\n\nCada vez que la Valent\xEDa alcanza ciertos Valores (Positivos
    o Negativos), tendr\xE1 efectos en el desempe\xF1o del Personaje en Combate.
    Ej: \"Motivado\".\n\nAdem\xE1s, es un Recurso que algunas habilidades utilizan.\n\n<b>---Estados</b> 
    (<b>X</b> = acumulaciones)\n\n\u2022<b>Ardiendo:</b> Cada <b>X</b> da\xF1ar\xE1
    en 2 a la Unidad al comienzo de su Turno, adem\xE1s la Unidad se ver\xE1 forzada
    a gastar PA hasta apagarlo. -3 <b>X</b> por PA gastado. \n\n\u2022<b>Congelado:</b>
    Cada <b>X</b> reduce 1 PA de la Unidad, y cada Turno disminuye en 1.\n\n\u2022<b>Aturdido:</b>
    Cada <b>X</b> hace que la Unidad pierda un turno. Disminuye en 1 cada turno.\n\n\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
