  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>---Damage Types / Critical Effects</b>\n\nEach Damage Type has a special
    effect on the target when the attack is also a Critical Hit, as detailed below:\n\n\u2022
    <b>Slashing:</b> Inflicts Bleeding on the target.\n\u2022 <b>Piercing:</b> Ignores
    Armor.\n\u2022 <b>Blunt:</b> Reduces the target\u2019s AP by 1.\n\n\u2022 <b>Fire:</b>
    Inflicts Burning.\n\u2022 <b>Frost:</b> Inflicts Frozen.\n\u2022 <b>Lightning:</b>
    Inflicts Stunned.\n\u2022 <b>Acid:</b> Reduces Armor.\n\u2022 <b>Arcane:</b>
    Reduces elemental Resistances.\n\u2022 <b>Necro:</b> Small chance to instantly
    kill the target.\n\u2022 <b>Divine:</b> Inflicts Condemned.\n\nThe status effects
    mentioned above and their descriptions are detailed in the Status section."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
