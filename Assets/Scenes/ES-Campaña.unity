--- !u!114 &946117617
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 946117615}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Global Valour represents your allies\u2019 collective morale in combat.\r\n\r\nIt
    is calculated from the group\u2019s current average VAL and shown as a percentage.\r\n\r\nThresholds:\r\n\r\nVery
    High (>=90%): all allies gain +15% damage and +1 Max AP for 1 round.\r\nHigh
    (>=70%): all allies gain +1 Max AP for 1 round.\r\nLow (<40%): at the start of
    the round, all allies roll a Mental Save.\r\nDC = 15 - current VAL.\r\nOn fail:
    they receive Doubting for 1 round (-10% damage, -1 Defense).\r\nVery Low (<15%):
    same Mental Save.\r\nOn fail: 1 ally per round flees the battle in shame.\r\nOther
    failed saves that round receive Doubting.\r\nBattle start:\r\nCaravan Hope adjusts
    each ally\u2019s starting VAL:\r\nfor every 20 points above/below 50, they gain/lose
    1 VAL.\r\n\r\nIf a unit flees due to morale, it gains the campaign state Ashamed
    until changing zone\r\n(-2 Mental Save, -10% Max HP)."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ff458e0654087aa41a97fa8ea3db3b66, type: 2}
  m_sharedMaterial: {fileID: -4687675609486072877, guid: ff458e0654087aa41a97fa8ea3db3b66, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
    serializedVersion: 2
    rgba: 4289388002
  m_fontColor: {r: 0.8867924, g: 0.86478764, b: 0.6650943, a: 1}
  m_enableVertexGradient: 0
  m_colorMode: 3
