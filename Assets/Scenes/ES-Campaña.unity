MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 639701028}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>---Enemigos</b>\n\nDurante el viaje, la caravana enfrentar\xE1 enemigos
    espec\xEDficos de la Regi\xF3n actual mezcaldos con enemigos generales que pueden
    tocar en cualqueir regi\xF3n (ej. Bandidos).\n\n\n<b>---Mec\xE1nicas</b>\n\nCada Regi\xF3n
    tiene una mec\xE1nica de juego que representa la tem\xE1tica principal de la
    Regi\xF3n. Estas mec\xE1nicas har\xE1n que cada una se sienta como un desaf\xEDo distinto.\n\n\n<b>---Modificadores</b>\n\nA
    veces las Regiones contar\xE1n con modificadores aleatorios que alterar\xE1n ciertos
    aspectos espec\xEDficos de la misma. Estos se aclarar\xE1n con anticipaci\xF3n
    para que el jugador pueda elegir acorde a esa informaci\xF3n."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
  m_sharedMaterial: {fileID: 1369702316804459117, guid: 54a3d28dd6785154fac83f0c31a69b7c, type: 2}
