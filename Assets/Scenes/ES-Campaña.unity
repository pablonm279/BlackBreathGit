  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Viajar pelo subsolo faz sentido para a caravana, j\xE1 que o <b>Respiro
    Negro</b> avan\xE7aria mais lentamente do que na superf\xEDcie.\nInfelizmente,
    a \xFAnica passagem subterr\xE2nea dispon\xEDvel \xE9 atrav\xE9s de <b>Nedukazal</b>.\nUm
    reino orgulhoso e recluso, que habita as cavernas com majestade. Mas, depois
    de ter levado a grande maioria de suas hostes para a batalha final contra o Lich
    Kadryn, seres desconhecidos aproveitaram a ocasi\xE3o e emergiram das fendas
    mais profundas para saquear o reino, destruindo-o quase por completo.\n\nAinda
    existem assentamentos que resistem aos\ninvasores, mas \xE9 apenas uma quest\xE3o
    de tempo at\xE9 que\n<b>Nedukazal</b> deixe de existir. Agora, a caravana ter\xE1
    \nde atravessar o reino, mergulhado na escurid\xE3o."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ff458e0654087aa41a97fa8ea3db3b66, type: 2}
  m_sharedMaterial: {fileID: -4687675609486072877, guid: ff458e0654087aa41a97fa8ea3db3b66, type: 2}
