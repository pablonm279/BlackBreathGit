#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File tools/check-mojibake.ps1 \
    -Staged -FailOnHit
  exit $?
fi

if command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass \
    -File tools/check-mojibake.ps1 -Staged -FailOnHit
  exit $?
fi

echo "[pre-commit] PowerShell no esta disponible; se usa validacion UTF-8 de respaldo."

files="$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR)"
if [ -z "${files}" ]; then
  exit 0
fi

has_issue=0

while IFS= read -r file; do
  case "$file" in
    .editorconfig|.gitattributes|.gitignore|.gitmodules|*/pre-commit|*/pre-push|*/commit-msg|*.cs|*.txt|*.md|*.json|*.xml|*.yml|*.yaml|*.csv|*.shader|*.cginc|*.hlsl|*.compute|*.uss|*.uxml|*.asmdef|*.asmref|*.meta|*.ps1|*.sh|*.asset|*.prefab|*.unity) ;;
    *) continue ;;
  esac

  content="$(git show ":$file" 2>/dev/null || true)"
  if [ -z "${content}" ]; then
    continue
  fi

  if command -v iconv >/dev/null 2>&1 \
    && ! printf '%s' "${content}" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1; then
    echo "[pre-commit] Archivo no UTF-8 valido: $file"
    has_issue=1
    continue
  fi

  if printf '%s' "${content}" | LC_ALL=C grep -n "$(printf '\357\277\275')" >/dev/null 2>&1; then
    echo "[pre-commit] Caracter de reemplazo Unicode detectado: $file"
    has_issue=1
  fi
done <<EOF
${files}
EOF

if [ "${has_issue}" -ne 0 ]; then
  echo "[pre-commit] Commit bloqueado por problemas de encoding."
  exit 1
fi

exit 0
