+      if (fondoFrente != null)
+      {
+        mrFondoFrente = fondoFrente.GetComponent<MeshRenderer>();
+      }
+    }
+
+    if (mrFondoFrente != null)
+    {
+      mrFondoFrente.sharedMaterial = fondoSeleccionado.fondoFrente;
